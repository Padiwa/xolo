package component

import (
	"github.com/xolo-gateway/xolo/internal/core/model"
	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/card"
)

type JoinPageVModel struct {
	User       model.User
	Org        model.Organization
	RoleName   string
	LoginURL   string
	DeclineURL string
}

templ JoinPage(vmodel JoinPageVModel) {
	@common.StandaloneLayout(common.WithTitle("Rejoindre " + vmodel.Org.Name())) {
		@card.Card() {
			@card.Header() {
				@card.Title() {
					Invitation à rejoindre { vmodel.Org.Name() }
				}
			}
			@card.Content() {
				<div class="space-y-4">
					<p class="text-sm text-muted-foreground">
						Vous avez été invité à rejoindre l'organisation <strong class="text-foreground">{ vmodel.Org.Name() }</strong>.
					</p>
					<div class="flex items-center gap-2.5 text-sm">
						<span class="font-medium">Rôle :</span>
						@common.Badge(common.ToneInfo, vmodel.RoleName)
					</div>
					if vmodel.User == nil {
						<p class="text-sm text-muted-foreground">Vous devez vous connecter pour accepter cette invitation.</p>
						@button.Button(button.Props{Href: vmodel.LoginURL, Class: "w-full"}) {
							Se connecter
						}
					} else {
						<div class="flex gap-2.5">
							<form method="POST" class="flex-1">
								@button.Button(button.Props{Type: button.TypeSubmit, Class: "w-full"}) {
									Rejoindre l'organisation
								}
							</form>
							<form method="POST" action={ templ.SafeURL(vmodel.DeclineURL) } class="flex-1">
								@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Class: "w-full"}) {
									Décliner
								}
							</form>
						</div>
					}
				</div>
			}
		}
	}
}

// JoinLogin intentionally receives no organization, recipient or role.
templ JoinLogin(loginURL string) {
	@common.StandaloneLayout(common.WithTitle("Invitation")) {
		@card.Card() {
			@card.Header() {
				@card.Title() {
					Invitation
				}
			}
			@card.Content() {
				<p class="mb-4 text-sm text-muted-foreground">Connectez-vous pour consulter cette invitation.</p>
				@button.Button(button.Props{Href: loginURL, Class: "w-full"}) {
					Se connecter
				}
			}
		}
	}
}
