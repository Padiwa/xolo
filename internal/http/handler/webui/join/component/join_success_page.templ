package component

import (
	"github.com/xolo-gateway/xolo/internal/core/model"
	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/card"
)

type JoinSuccessVModel struct {
	User          model.User
	OrgName       string
	OrgSlug       string
	RoleName      string
	AlreadyMember bool
	Destination   string
}

templ JoinSuccess(vmodel JoinSuccessVModel) {
	@common.StandaloneLayout(common.WithTitle("Bienvenue dans " + vmodel.OrgName)) {
		@card.Card() {
			@card.Header() {
				@card.Title() {
					Bienvenue !
				}
			}
			@card.Content() {
				<div class="space-y-4">
					if vmodel.AlreadyMember {
						<p class="text-sm text-muted-foreground">Vous êtes déjà membre de l'organisation <strong class="text-foreground">{ vmodel.OrgName }</strong>. Vos rôles sont conservés.</p>
					} else {
						<p class="text-sm text-muted-foreground">Vous avez rejoint l'organisation <strong class="text-foreground">{ vmodel.OrgName }</strong>.</p>
					}
					if vmodel.RoleName != "" {
						<p class="text-sm">Rôle : { vmodel.RoleName }</p>
					}
					@button.Button(button.Props{Href: vmodel.Destination, Class: "w-full"}) {
						Continuer
					}
				</div>
			}
		}
	}
}
